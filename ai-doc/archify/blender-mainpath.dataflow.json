  "cards": [
    {
      "dot": "cyan",
      "title": "写入只有两条链",
      "items": [
        "面板用 layout.prop 走 RNA；layout.operator 与快捷键一样进 WM Operator",
        "图上只画两条写入主路，避免同一走廊叠两条命令边"
      ]
    },
    {
      "dot": "emerald",
      "title": "同一份网格",
      "items": [
        "编辑模式真相在 MeshRuntime.edit_mesh 的 BMesh",
        "写回后 DEG_id_tag_update，notifier 只通知重绘"
      ]
    },
    {
      "dot": "orange",
      "title": "像素分道",
      "items": [
        "视口：DAG_EVAL_VIEWPORT + DRW_draw_view",
        "F12：DAG_EVAL_RENDER + RE_engine_render，Cycles 吃求值网格"
      ]
    }
  ]
